# Xiaomi-specific file types for sky (Redmi 12 5G)
#
# The stock vendor image does not ship a vendor_sepolicy.cil that this tree
# installs, so every type referenced by our genfs_contexts / file_contexts
# must be declared here. Do not assume a type already exists upstream.

# Display
type vendor_sysfs_displayfeature, fs_type, sysfs_type;

# Touch
type vendor_sysfs_touch, fs_type, sysfs_type;
type vendor_touch_data_file, data_file_type, file_type;

# Xiaomi hardware services
type vendor_hal_displayfeature_hwservice, hwservice_manager_type;
type hal_touchfeature_hwservice, hwservice_manager_type;
type vendor_hal_micharge_hwservice, hwservice_manager_type;
type vendor_hal_misys_hwservice, hwservice_manager_type;
type vendor_hal_mimd_hwservice, hwservice_manager_type;
type vendor_hal_cld_hwservice, hwservice_manager_type;
type vendor_hal_otrpagent_hwservice, hwservice_manager_type;

# Thermal
type vendor_thermal_data_file, data_file_type, file_type;
type sys_thermal_wifi_limit, fs_type, sysfs_type;

# Millet (Xiaomi power/performance framework)
type vendor_millet_data_file, data_file_type, file_type;

# Charge
type vendor_micharge_data_file, data_file_type, file_type;

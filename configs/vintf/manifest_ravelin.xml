     Device manifest for SM4450 (parrot) / ravelin. Declares the vendor HALs that
     ship as prebuilt blobs rather than being built from source, so they are not
     described by any AOSP or CAF manifest fragment.
-->
<manifest version="1.0" type="device" target-level="202404">
    <!-- Wifi display session, shipped only as a blob -->
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.wifidisplaysession_aidl</name>
        <version>1</version>
        <fqname>IWifiDisplaySession/default</fqname>
        <fqname>IWifiDisplaySessionVideoTrack/default</fqname>
        <fqname>IWifiDisplaySessionAudioTrack/default</fqname>
        <fqname>IWifiDisplaySessionImageTrack/default</fqname>
    </hal>

    <!-- Gatekeeper -->
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <version>1</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>

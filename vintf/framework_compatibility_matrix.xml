     Framework compatibility matrix additions for SM4450 (parrot) / ravelin.
     The QCRIL NV-option interface is optional: firmware revisions differ in
     whether they export it, so the framework must not require it.
-->
<compatibility-matrix version="1.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.radio.qcriNvOpt</name>
        <interface>
            <name>IqcriNvOpt</name>
            <regex-instance>qcrinvopt[0-9]+</regex-instance>
        </interface>
    </hal>
</compatibility-matrix>
